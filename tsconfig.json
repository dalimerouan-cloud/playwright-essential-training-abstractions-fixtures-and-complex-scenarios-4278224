{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@datafactory/*": ["lib/pages/datafactory/*"],
      "@helpers/*": ["lib/pages/helpers/*"],
      "@pages/*": ["lib/pages/*"],
      "@fixtures*": ["lib/pages/fixtures/*"]
    }
  },
  "include": ["**/*.ts"]
}
